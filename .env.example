# Copy to .env with `npm run setup` (fills in the secrets below for you).
# docker compose and `npm run dev` both read this file. Never commit .env.

# ---------- App ----------
SITE_URL=http://localhost:3000
APP_PORT=3000

# ---------- Database (PostgreSQL 15+) ----------
# Default: a throwaway local database container (profile local-db).
# To use your own server instead: set POSTGRES_HOST/PORT/USER/PASSWORD to it and
# clear COMPOSE_PROFILES. The user must be a superuser (to create service roles).
COMPOSE_PROFILES=local-db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=
# Password for the service logins (authenticator, supabase_auth_admin,
# supabase_storage_admin) that bootstrap creates. Generated by `npm run setup`.
DB_SERVICE_PASSWORD=

# ---------- Supabase secrets (generated by `npm run setup`) ----------
JWT_SECRET=
# JWTs signed with JWT_SECRET: anon = public key, service_role = server-only, bypasses RLS.
ANON_KEY=
SERVICE_ROLE_KEY=

# ---------- Supabase URLs ----------
# Public gateway URL (Kong). Auth email links point here.
API_EXTERNAL_URL=http://localhost:8000
# Extra allowed auth redirect URLs, comma-separated.
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**

# Server-side (used by `npm run dev`; docker compose overrides SUPABASE_URL).
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side (baked into the client bundle at build time).
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Email ----------
# Registration confirmations are sent with Resend (https://resend.com) when
# RESEND_API_KEY is set. Without it, mail goes over SMTP below, which locally is
# Mailpit: open http://localhost:54324 to see every email the app sends.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "C8 Tech Summit <hello@c8techsummit.com>".
EMAIL_FROM="C8 Tech Summit <hello@c8techsummit.local>"
EMAIL_REPLY_TO=C8techsummit@gmail.com

# SMTP fallback for local development (Mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Supabase Auth emails (magic links). Locally Mailpit; in production use Resend's
# SMTP: host smtp.resend.com, port 465, user "resend", password = your Resend API key.
AUTH_SMTP_HOST=mailpit
AUTH_SMTP_PORT=1025
AUTH_SMTP_USER=local
AUTH_SMTP_PASS=local
AUTH_SMTP_ADMIN_EMAIL=hello@c8techsummit.local

# Set to true only behind a proxy/CDN that sets X-Forwarded-For (Vercel, a load
# balancer). Otherwise the header is client-controlled and rate limits use the socket IP.
TRUST_PROXY=false

# ---------- Host ports for local services ----------
KONG_PORT=8000
LOCAL_DB_PORT=54322
STUDIO_PORT=54323
MAILPIT_PORT=54324
